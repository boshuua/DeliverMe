# ==========================================
# DeliverMe - Comprehensive Root .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build and Production Artifacts
dist/
**/dist/
build/
**/build/
out-tsc/
**/out-tsc/
.angular/
**/.angular/
tmp/
**/tmp/

# Uploads & Media Storage (Proof-of-Delivery Photos & Signatures)
uploads/
**/uploads/
!**/uploads/.gitkeep

# Environment & Sensitive Credentials
.env
**/.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# Database & Sqitch Locks
sqitch.conf.lock
**/sqitch.conf.lock
postgres_data/
**/postgres_data/

# Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
**/coverage/
*.lcov
.nyc_output

# IDEs & Text Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
